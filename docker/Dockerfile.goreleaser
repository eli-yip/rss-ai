FROM alpine:3.22

RUN sed -i 's/dl-cdn.alpinelinux.org/mirrors.tuna.tsinghua.edu.cn/g' /etc/apk/repositories \
  && apk add --no-cache -U tzdata

RUN sed -i 's#https://mirrors.tuna.tsinghua.edu.cn/alpine#https://dl-cdn.alpinelinux.org/alpine#g' /etc/apk/repositories

WORKDIR /app

COPY rss-ai /app/rss-ai

ENV TZ=Asia/Shanghai

EXPOSE 8080

# Reads ./config.toml by default; mount one at /app/config.toml or override with -c.
ENTRYPOINT ["./rss-ai"]
